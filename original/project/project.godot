; Meadowmind — Godot 4 survival laboratory
config_version=5

[application]
config/name="芽野 · Meadowmind"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A bright survival sandbox and transparent small-model agent laboratory."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.windows="mobile"
rendering_device/driver.windows="d3d12"
gl_compatibility/driver.windows="opengl3_angle"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.88, 0.95, 0.85, 1)

[audio]
driver/enable_input=false
